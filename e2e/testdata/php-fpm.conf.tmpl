; The php-fpm config for the e2e tests. TestMain renders it with text/template for the PHP
; version of the image: decorate_workers_output is PHP 7.3+.
; The wrapper replaces error_log and slowlog with FIFOs and parses them.

[global]
error_log = /tmp/php-fpm.log
log_level = notice
; Let the children finish the current request after SIGQUIT.
process_control_timeout = 10s

[www]
; php-fpm ignores user and group when the master does not run as root.
user = www-data
group = www-data
listen = 9000
pm = static
pm.max_children = 2
pm.status_path = /status

; The wrapper must replace $pool with the name of the pool.
slowlog = /tmp/php-fpm-$pool.slow.log
request_slowlog_timeout = 1

; Keep the environment of the wrapper: it contains FPM_WRAPPER_SOCK and FPM_WRAPPER_PIPE.
clear_env = no
catch_workers_output = yes

; The session cleanup of the wrapper must read these values. The PHP garbage collector is off,
; so that only the wrapper removes the session files.
php_value[session.save_path] = /tmp/sessions
php_value[session.gc_maxlifetime] = 2
php_admin_value[session.gc_probability] = 0

; A pool without a status page. It writes the stderr of the workers to the error log without
; a change.
[raw]
user = www-data
group = www-data
listen = 9001
pm = static
pm.max_children = 1
slowlog = /tmp/php-fpm-$pool.slow.log
request_slowlog_timeout = 1
clear_env = no
catch_workers_output = yes
{{- if .DecorateWorkersOutput}}
decorate_workers_output = no
{{- end}}
